debug=false

# Paths are relative to the project root unless absolute.
PIPELINE_INPUT_JSONL=dataset/RSchema/preprocessing/results/cleaned.jsonl
PIPELINE_SPEC_FIELD=question
PIPELINE_ID_FIELD=id

# Use hosted with a provider/model name, or ollama with a local model tag.
PIPELINE_BACKEND=ollama
PIPELINE_MODEL=qwen3.5:9b-q4_K_M
PIPELINE_API_KEY=
PIPELINE_API_BASE=
PIPELINE_TIMEOUT_SECONDS=300
PIPELINE_MAX_ITERATIONS=3

PIPELINE_EXTRACTION_PROMPT=pipeline/prompts/extract_fds_attributes_and_types_prompt.txt
PIPELINE_SCHEMA_PROMPT=pipeline/prompts/generate_relational_schema_prompt.txt

# Hosted API examples checked on 2026-11-22 for availability through 2027-01-04.
# Lightest means lowest standard text token prices among the eligible models.
# Replace the active backend, key, and API base above, then choose one model line.
# PIPELINE_BACKEND=hosted
# PIPELINE_API_KEY=your_provider_api_key
# PIPELINE_API_BASE=

# Gemini Developer API. Gemini 2.5 access is limited to prior users.
# Oldest stable and lightest for new projects. Earliest shutdown 2027-05-07.
# PIPELINE_MODEL=gemini/gemini-3.1-flash-lite

# OpenAI API.
# PIPELINE_MODEL=openai/gpt-4o-mini-2024-07-18  # Oldest. Retires 2027-01-14.
# PIPELINE_MODEL=openai/gpt-6-luna  # Lightest

# Anthropic Claude API.
# PIPELINE_MODEL=anthropic/claude-haiku-4-5-20251001  # Oldest. Active with no retirement announced.
# PIPELINE_MODEL=anthropic/claude-haiku-5-5  # Lightest

# Local Ollama on Fir (Digital Research Alliance of Canada).
# Request --nodes=1 --gpus=h100:1 for one full 80 GB H100.
# Run Ollama and the pipeline on the same GPU node within the Slurm allocation.
# OLLAMA_MODELS="$SCRATCH/ollama-models" OLLAMA_CONTEXT_LENGTH=32768 ollama serve
# With the server running, use ollama pull <model-tag> on that node. Fir compute
# nodes have internet access, and the model store in $SCRATCH can be reused.
# Set PIPELINE_MODEL in .env to the tag you pulled.
# Download sizes are listed below. Context and inference need additional VRAM.
# PIPELINE_BACKEND=ollama
# PIPELINE_API_KEY=
# PIPELINE_API_BASE=http://127.0.0.1:11434
# PIPELINE_MODEL=qwen3.5:35b-a3b-q8_0  # 35B total, 3B active per token, 39 GB download
# PIPELINE_MODEL=qwen3.8:27b-q8_0     # 30 GB download
# PIPELINE_MODEL=qwen3.5:9b-q4_K_M    # 6.6 GB download
